#!/bin/sh
# .githooks/commit-msg
# Luat cung: thay ten AI trong commit message hoac trong danh tinh commit la chan.
# Bat bang: bash scripts/setup-hooks.sh  (git config core.hooksPath .githooks)

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: thieu file message" >&2
  exit 1
fi

fail_note() {
  printf 'Chi commit message va danh tinh commit bi quet, noi dung tep trong repo khong bi anh huong.\n' >&2
  printf 'Sua: bo phan vi pham roi commit lai, vi du: git commit --amend -m "<message khac>".\n\n' >&2
  exit 1
}

hits=$(grep -Ein 'claude|anthropic' "$msg_file" || true)
if [ -n "$hits" ]; then
  printf '\n[BLOCKED] commit message chua ten AI, dong vi pham:\n' >&2
  printf '%s\n' "$hits" | sed 's/^/    /' >&2
  fail_note
fi

check_ident() {
  who=$1
  name=$2
  mail=$3
  if printf '%s <%s>' "$name" "$mail" | grep -Eiq 'claude|anthropic'; then
    printf '\n[BLOCKED] danh tinh %s la "%s <%s>".\n' "$who" "$name" "$mail" >&2
    fail_note
  fi
}

check_ident AUTHOR "${GIT_AUTHOR_NAME:-$(git config user.name)}" "${GIT_AUTHOR_EMAIL:-$(git config user.email)}"
check_ident COMMITTER "${GIT_COMMITTER_NAME:-$(git config user.name)}" "${GIT_COMMITTER_EMAIL:-$(git config user.email)}"

exit 0
